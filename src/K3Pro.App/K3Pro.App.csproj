<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generated by tools/make_icon.py -->
    <ApplicationIcon>Assets\k3pro.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\K3Pro.Protocol\K3Pro.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Physical position of each matrix index — hand-tuned to match the real keys. -->
    <None Include="layout.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\k3pro.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="K3Pro.App.Tests" />
  </ItemGroup>

</Project>
