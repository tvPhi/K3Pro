<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:K3Pro.App.ViewModels"
             xmlns:l="using:K3Pro.App.Localization"
             x:Class="K3Pro.App.Views.LogView"
             x:DataType="vm:LogViewModel">

  <Border Background="#111317">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" Margin="12,6,12,4">
        <TextBlock VerticalAlignment="Center" FontSize="12" Classes="muted"
                   Text="{Binding Header}" />
        <Button Grid.Column="1" Content="{Binding Clear, Source={x:Static l:Tr.I}}" Padding="10,2" FontSize="12" Command="{Binding ClearCommand}" />
      </Grid>
      <ListBox x:Name="List" Grid.Row="1" Classes="log" ItemsSource="{Binding Entries}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogEntryViewModel">
            <StackPanel Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Time}" VerticalAlignment="Center" />
                <Border Classes="kind" Classes.set="{Binding IsSet}" Classes.get="{Binding IsGet}"
                        Classes.warn="{Binding IsWarning}" Classes.err="{Binding IsError}">
                  <TextBlock Text="{Binding KindText}" />
                </Border>
                <TextBlock FontSize="12" Text="{Binding Summary}" VerticalAlignment="Center" />
              </StackPanel>
              <SelectableTextBlock Classes="mono muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="{Binding Hex}" IsVisible="{Binding HasHex}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
