<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="K3Pro.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>
    <SolidColorBrush x:Key="WindowBg" Color="#15171C" />
    <SolidColorBrush x:Key="CardBg" Color="#1C1F25" />
    <SolidColorBrush x:Key="CardBorder" Color="#2A2E36" />
    <SolidColorBrush x:Key="KeyBg" Color="#252932" />
    <SolidColorBrush x:Key="KeyBgHover" Color="#2D323C" />
    <SolidColorBrush x:Key="KeyBorder" Color="#363B45" />
    <SolidColorBrush x:Key="AccentBlue" Color="#5B9BFF" />
    <SolidColorBrush x:Key="Amber" Color="#E3A82B" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="Ok" Color="#3DD68C" />
    <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- Inter turns "0x59" into "0×59" (calt) — use Segoe UI for the UI; hex always uses MonoFont. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, $Default" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="TabControl.sub TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <Style Selector="Border.warn">
      <Setter Property="Background" Value="#33290F" />
      <Setter Property="BorderBrush" Value="#7A5B17" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.error">
      <Setter Property="Background" Value="#3A1618" />
      <Setter Property="BorderBrush" Value="#8A2A2E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Ellipse.status">
      <Setter Property="Fill" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="Ellipse.status.on">
      <Setter Property="Fill" Value="{StaticResource Ok}" />
    </Style>
    <Style Selector="Ellipse.status.bt">
      <Setter Property="Fill" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Border.blocked">
      <Setter Property="Background" Value="#33290F" />
      <Setter Property="BorderBrush" Value="#7A5B17" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.blocked.bt">
      <Setter Property="Background" Value="#1F2A3D" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Border.battery">
      <Setter Property="Background" Value="#16392A" />
      <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,1" />
    </Style>
    <Style Selector="Border.battery TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Keys on the layout -->
    <Style Selector="Button.key">
      <Setter Property="Background" Value="{StaticResource KeyBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="4,6,4,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource KeyBgHover}" />
    </Style>
    <Style Selector="Button.key.remapped">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Button.key.remapped TextBlock.keyLabel">
      <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Button.key.selected">
      <Setter Property="Background" Value="#2C3850" />
      <Setter Property="BorderBrush" Value="#9CC2FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.key.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33405A" />
      <Setter Property="BorderBrush" Value="#9CC2FF" />
    </Style>
    <Style Selector="Button.key.pending">
      <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.key.pending TextBlock.keyLabel">
      <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Button.key.pending:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Button.key.knob">
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.key.locked">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Function picker (like the vendor app) -->
    <Style Selector="TabControl.picker TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="9,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.pick">
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="{StaticResource KeyBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource KeyBgHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Button.pick.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBlue}" />
      <Setter Property="BorderBrush" Value="#9CC2FF" />
    </Style>
    <Style Selector="Button.pick.selected TextBlock">
      <Setter Property="Foreground" Value="#0B1220" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pick.locked">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.pick.locked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}" />
    </Style>
    <Style Selector="Button.pick.effect">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="Button.pick.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.mod">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.current">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#2C3850" />
      <Setter Property="BorderBrush" Value="#9CC2FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.current TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.current.pending">
      <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Border.current.pending TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Border.combo">
      <Setter Property="Background" Value="#1F2A3D" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.combo TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
    </Style>
    <Style Selector="Border.note">
      <Setter Property="Background" Value="#22262E" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.note TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Border.capture">
      <Setter Property="Background" Value="#1F2A3D" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.capture TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Log -->
    <Style Selector="Border.kind">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Background" Value="#2A2E36" />
    </Style>
    <Style Selector="Border.kind TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kind.set"><Setter Property="Background" Value="#1F3A63" /></Style>
    <Style Selector="Border.kind.get"><Setter Property="Background" Value="#1E4A3A" /></Style>
    <Style Selector="Border.kind.warn"><Setter Property="Background" Value="#5A3A10" /></Style>
    <Style Selector="Border.kind.err"><Setter Property="Background" Value="#6A1F22" /></Style>
    <Style Selector="ListBox.log ListBoxItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Border.toast">
      <Setter Property="Background" Value="#16392A" />
      <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Border.toast.err">
      <Setter Property="Background" Value="#3A1618" />
      <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource Danger}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
